# 统一换行符，避免跨平台协作时整文件 diff
* text=auto eol=lf

# Windows 脚本保持 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# 二进制文件不做换行符转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.jar binary
*.apk binary
*.keystore binary
*.jks binary

# 协议研究文档按语言自动高亮
API_RESEARCH.md linguist-language=Markdown
